<!-- The songs etc. in a Session (the live one or an opened recording), with heart rate for each. Picking a row selects its time. -->
<UserControl x:Class="HeartRateMonitor.Controls.SpanGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid ItemsSource="{Binding Spans}" SelectedItem="{Binding SelectedSpan}"
              AutoGenerateColumns="False" IsReadOnly="True"
              CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single"
              Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
        <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="BorderBrush" Value="#E0E0E0" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSegment}" Value="True">
                        <Setter Property="Foreground" Value="#666" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridTextColumn Header="Start" Width="65" Binding="{Binding StartText}" />
            <DataGridTextColumn Header="What" Width="*" Binding="{Binding DisplayLabel}" />
            <DataGridTextColumn Header="Time" Width="55" Binding="{Binding DurationText}" />
            <DataGridTextColumn Header="Avg" Width="45" Binding="{Binding AvgBpm}" FontWeight="SemiBold" />
            <DataGridTextColumn Header="Max" Width="45" Binding="{Binding MaxBpm}" />
            <DataGridTextColumn Header="Min" Width="45" Binding="{Binding MinBpm}" />
            <DataGridTextColumn Header="Result" Width="80" Binding="{Binding Result}" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
